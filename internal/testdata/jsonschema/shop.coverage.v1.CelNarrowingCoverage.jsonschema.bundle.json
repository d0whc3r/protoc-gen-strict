{
  "$defs": {
    "google.protobuf.FieldMask.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Field Mask",
      "type": "string"
    },
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "shop.coverage.v1.CelNarrowingCoverage.Inner.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Inner holds the fields the nested-shape rule reaches into: a message\n field, which tracks presence, and an enum.",
      "properties": {
        "flavor": {
          "anyOf": [
            {
              "pattern": "^FLAVOR_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "FLAVOR_SWEET",
                "FLAVOR_SALTY",
                "FLAVOR_SOUR",
                "FLAVOR_BITTER"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Constrained to its zero member by the message rule above.",
          "title": "Flavor"
        },
        "mask": {
          "$ref": "#/$defs/google.protobuf.FieldMask.jsonschema.json",
          "description": "Reached through by the foreign-path rule above."
        },
        "stamp": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Constrained to be present by the message rule above."
        }
      },
      "title": "Inner",
      "type": "object"
    },
    "shop.coverage.v1.CelNarrowingCoverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "CelNarrowingCoverage exercises the CEL shapes that become part of the\n generated type rather than being left to runtime validation.",
      "properties": {
        "detail": {
          "$ref": "#/$defs/shop.coverage.v1.StringRuleCoverage.jsonschema.json",
          "description": "Constrained to be present, and narrowed through, by the rules above."
        },
        "flavor": {
          "anyOf": [
            {
              "pattern": "^FLAVOR_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "FLAVOR_SWEET",
                "FLAVOR_SALTY",
                "FLAVOR_SOUR",
                "FLAVOR_BITTER"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Constrained to its zero member by the message rule above.",
          "title": "Flavor"
        },
        "inner": {
          "$ref": "#/$defs/shop.coverage.v1.CelNarrowingCoverage.Inner.jsonschema.json",
          "description": "Narrowed through by the nested-shape rule above."
        },
        "label": {
          "default": "",
          "description": "Constrained to be non-empty by the message rule above.",
          "type": "string"
        },
        "note": {
          "description": "Constrained to be absent by the message rule above.",
          "type": "string"
        },
        "slug": {
          "default": "",
          "description": "Constrained to be empty by the message rule above.",
          "type": "string"
        }
      },
      "title": "Cel Narrowing Coverage",
      "type": "object"
    },
    "shop.coverage.v1.StringRuleCoverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "StringRuleCoverage exercises the string rule family, including the\n well-known format rules that live in a oneof inside StringRules.",
      "patternProperties": {
        "^(byte_bounds)$": {
          "default": "",
          "description": "Byte length bounds, which differ from character length for non-ASCII.",
          "maxLength": 128,
          "type": "string"
        },
        "^(exact_len)$": {
          "default": "",
          "description": "Exact character length.",
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        "^(header_name)$": {
          "default": "",
          "description": "Well-known format: HTTP header name, matched strictly.",
          "type": "string"
        },
        "^(host_and_port)$": {
          "default": "",
          "description": "Well-known format: host:port pair.",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "^(ip_prefix)$": {
          "default": "",
          "description": "Well-known format: CIDR prefix.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}0/([0-9]|[12][0-9]|3[0-2])$|^(([0-9a-fA-F]{1,4}:){1,7}:|::)/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$",
          "type": "string"
        },
        "^(len_bounds)$": {
          "default": "",
          "description": "Character length bounds.",
          "maxLength": 64,
          "minLength": 2,
          "type": "string"
        },
        "^(uri_ref)$": {
          "default": "",
          "description": "Well-known format: relative URI reference.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?:\\/\\/(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        }
      },
      "properties": {
        "affixes": {
          "default": "",
          "description": "Substring rules.",
          "pattern": "^id_.*-.*_v1$",
          "type": "string"
        },
        "byteBounds": {
          "default": "",
          "description": "Byte length bounds, which differ from character length for non-ASCII.",
          "maxLength": 128,
          "type": "string"
        },
        "constant": {
          "default": "",
          "description": "Fixed value.",
          "enum": [
            "fixed"
          ],
          "type": "string"
        },
        "email": {
          "default": "",
          "description": "Well-known format: email address.",
          "format": "email",
          "type": "string"
        },
        "enumerated": {
          "default": "",
          "description": "Membership rules.",
          "enum": [
            "alpha",
            "beta",
            "stable"
          ],
          "type": "string"
        },
        "exactLen": {
          "default": "",
          "description": "Exact character length.",
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        "headerName": {
          "default": "",
          "description": "Well-known format: HTTP header name, matched strictly.",
          "type": "string"
        },
        "hostAndPort": {
          "default": "",
          "description": "Well-known format: host:port pair.",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "hostname": {
          "default": "",
          "description": "Well-known format: hostname.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*$",
          "type": "string"
        },
        "ip": {
          "default": "",
          "description": "Well-known format: IP address of either version.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)$",
          "type": "string"
        },
        "ipPrefix": {
          "default": "",
          "description": "Well-known format: CIDR prefix.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}0/([0-9]|[12][0-9]|3[0-2])$|^(([0-9a-fA-F]{1,4}:){1,7}:|::)/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$",
          "type": "string"
        },
        "ipv4": {
          "default": "",
          "description": "Well-known format: IPv4 address.",
          "format": "ipv4",
          "type": "string"
        },
        "ipv6": {
          "default": "",
          "description": "Well-known format: IPv6 address.",
          "format": "ipv6",
          "type": "string"
        },
        "lenBounds": {
          "default": "",
          "description": "Character length bounds.",
          "maxLength": 64,
          "minLength": 2,
          "type": "string"
        },
        "pattern": {
          "default": "",
          "description": "Must match a regular expression.",
          "pattern": "^[a-z]+(_[a-z]+)*$",
          "type": "string"
        },
        "tuuid": {
          "default": "",
          "description": "Well-known format: trimmed UUID (no dashes).",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "uri": {
          "default": "",
          "description": "Well-known format: URI.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?://(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "uriRef": {
          "default": "",
          "description": "Well-known format: relative URI reference.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?:\\/\\/(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "uuid": {
          "default": "",
          "description": "Well-known format: UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "title": "String Rule Coverage",
      "type": "object"
    }
  },
  "$id": "shop.coverage.v1.CelNarrowingCoverage.jsonschema.bundle.json",
  "$ref": "#/$defs/shop.coverage.v1.CelNarrowingCoverage.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
