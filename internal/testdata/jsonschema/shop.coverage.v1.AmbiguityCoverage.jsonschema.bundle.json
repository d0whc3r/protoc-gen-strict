{
  "$defs": {
    "shop.coverage.v1.AmbiguityCoverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AmbiguityCoverage exercises the cases where the proto text and what the\n generated code declares come apart: a property named by something other than\n the field, a rule combination no target can carry, and a rule the overlay has\n to report rather than translate.",
      "patternProperties": {
        "^(legacy_note)$": {
          "default": "",
          "description": "Narrowed to empty by the implicit-presence rule above.",
          "type": "string"
        },
        "^(optional_tags)$": {
          "description": "Element rules that are skipped for an empty element, so a `minLength` on\n the array items would reject what protovalidate accepts.",
          "items": {
            "minLength": 3,
            "type": "string"
          },
          "type": "array"
        },
        "^(outside_window)$": {
          "anyOf": [
            {
              "exclusiveMaximum": 10,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "exclusiveMaximum": 2147483648,
              "exclusiveMinimum": 20,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "A reversed range: protovalidate reads a lower bound above the upper one as\n \"outside 10..20\", which a JSONSchema `minimum` and `maximum` cannot say."
        },
        "^(unchecked_detail)$": {
          "$ref": "#/$defs/shop.coverage.v1.StringRuleCoverage.jsonschema.json",
          "description": "Validation is switched off for this field, the recursion into the message\n it carries included, so the overlay must not demand the target's strict\n type either."
        },
        "^(user_id)$": {
          "default": "",
          "description": "The JSON name is overridden, which renames the wire encoding and nothing\n else: protobuf-es still declares the property after the proto field name.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "properties": {
        "constructor": {
          "default": "",
          "description": "A name every JavaScript object already carries. protobuf-es escapes the\n property with a trailing `$`.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "email": {
          "description": "Email address.",
          "format": "email",
          "type": "string"
        },
        "external-id": {
          "default": "",
          "description": "The JSON name is overridden, which renames the wire encoding and nothing\n else: protobuf-es still declares the property after the proto field name.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "label": {
          "default": "",
          "description": "Narrowed to non-empty by the implicit-presence rule above.",
          "type": "string"
        },
        "legacyNote": {
          "default": "",
          "description": "Narrowed to empty by the implicit-presence rule above.",
          "type": "string"
        },
        "nickname": {
          "description": "Required and non-empty by the presence-and-value rule above.",
          "type": "string"
        },
        "optionalTags": {
          "description": "Element rules that are skipped for an empty element, so a `minLength` on\n the array items would reject what protovalidate accepts.",
          "items": {
            "minLength": 3,
            "type": "string"
          },
          "type": "array"
        },
        "outsideWindow": {
          "anyOf": [
            {
              "exclusiveMaximum": 10,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "exclusiveMaximum": 2147483648,
              "exclusiveMinimum": 20,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "A reversed range: protovalidate reads a lower bound above the upper one as\n \"outside 10..20\", which a JSONSchema `minimum` and `maximum` cannot say."
        },
        "phone": {
          "description": "E.164 phone number.",
          "minLength": 5,
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The same across several lines, on a field rather than the message."
        },
        "uncheckedDetail": {
          "$ref": "#/$defs/shop.coverage.v1.StringRuleCoverage.jsonschema.json",
          "description": "Validation is switched off for this field, the recursion into the message\n it carries included, so the overlay must not demand the target's strict\n type either."
        }
      },
      "title": "Ambiguity Coverage",
      "type": "object"
    },
    "shop.coverage.v1.StringRuleCoverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "StringRuleCoverage exercises the string rule family, including the\n well-known format rules that live in a oneof inside StringRules.",
      "patternProperties": {
        "^(byte_bounds)$": {
          "default": "",
          "description": "Byte length bounds, which differ from character length for non-ASCII.",
          "maxLength": 128,
          "type": "string"
        },
        "^(exact_len)$": {
          "default": "",
          "description": "Exact character length.",
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        "^(header_name)$": {
          "default": "",
          "description": "Well-known format: HTTP header name, matched strictly.",
          "type": "string"
        },
        "^(host_and_port)$": {
          "default": "",
          "description": "Well-known format: host:port pair.",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "^(ip_prefix)$": {
          "default": "",
          "description": "Well-known format: CIDR prefix.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}0/([0-9]|[12][0-9]|3[0-2])$|^(([0-9a-fA-F]{1,4}:){1,7}:|::)/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$",
          "type": "string"
        },
        "^(len_bounds)$": {
          "default": "",
          "description": "Character length bounds.",
          "maxLength": 64,
          "minLength": 2,
          "type": "string"
        },
        "^(uri_ref)$": {
          "default": "",
          "description": "Well-known format: relative URI reference.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?:\\/\\/(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        }
      },
      "properties": {
        "affixes": {
          "default": "",
          "description": "Substring rules.",
          "pattern": "^id_.*-.*_v1$",
          "type": "string"
        },
        "byteBounds": {
          "default": "",
          "description": "Byte length bounds, which differ from character length for non-ASCII.",
          "maxLength": 128,
          "type": "string"
        },
        "constant": {
          "default": "",
          "description": "Fixed value.",
          "enum": [
            "fixed"
          ],
          "type": "string"
        },
        "email": {
          "default": "",
          "description": "Well-known format: email address.",
          "format": "email",
          "type": "string"
        },
        "enumerated": {
          "default": "",
          "description": "Membership rules.",
          "enum": [
            "alpha",
            "beta",
            "stable"
          ],
          "type": "string"
        },
        "exactLen": {
          "default": "",
          "description": "Exact character length.",
          "maxLength": 10,
          "minLength": 10,
          "type": "string"
        },
        "headerName": {
          "default": "",
          "description": "Well-known format: HTTP header name, matched strictly.",
          "type": "string"
        },
        "hostAndPort": {
          "default": "",
          "description": "Well-known format: host:port pair.",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "hostname": {
          "default": "",
          "description": "Well-known format: hostname.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*$",
          "type": "string"
        },
        "ip": {
          "default": "",
          "description": "Well-known format: IP address of either version.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)$",
          "type": "string"
        },
        "ipPrefix": {
          "default": "",
          "description": "Well-known format: CIDR prefix.",
          "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}0/([0-9]|[12][0-9]|3[0-2])$|^(([0-9a-fA-F]{1,4}:){1,7}:|::)/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$",
          "type": "string"
        },
        "ipv4": {
          "default": "",
          "description": "Well-known format: IPv4 address.",
          "format": "ipv4",
          "type": "string"
        },
        "ipv6": {
          "default": "",
          "description": "Well-known format: IPv6 address.",
          "format": "ipv6",
          "type": "string"
        },
        "lenBounds": {
          "default": "",
          "description": "Character length bounds.",
          "maxLength": 64,
          "minLength": 2,
          "type": "string"
        },
        "pattern": {
          "default": "",
          "description": "Must match a regular expression.",
          "pattern": "^[a-z]+(_[a-z]+)*$",
          "type": "string"
        },
        "tuuid": {
          "default": "",
          "description": "Well-known format: trimmed UUID (no dashes).",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "uri": {
          "default": "",
          "description": "Well-known format: URI.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?://(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "uriRef": {
          "default": "",
          "description": "Well-known format: relative URI reference.",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?:\\/\\/(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "uuid": {
          "default": "",
          "description": "Well-known format: UUID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "title": "String Rule Coverage",
      "type": "object"
    }
  },
  "$id": "shop.coverage.v1.AmbiguityCoverage.jsonschema.bundle.json",
  "$ref": "#/$defs/shop.coverage.v1.AmbiguityCoverage.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
