      "description": "Ping and Pong refer to each other: a cycle across two messages.",
      "properties": {
        "note": {
          "default": "",
          "description": "A rule inside the cycle.",
          "maxLength": 140,
          "type": "string"
        },
        "pong": {
          "$ref": "#/$defs/shop.schema.v1.Pong.jsonschema.json",
