        }
      },
      "title": "Ping",
      "type": "object"
    },
    "shop.schema.v1.Pong.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Pong is the other half of the Ping cycle.",
      "properties": {
        "ping": {
          "$ref": "#/$defs/shop.schema.v1.Ping.jsonschema.json",
          "description": "Closes the cycle."
        }
      },
      "title": "Pong",
      "type": "object"
    }
  },
  "$id": "shop.schema.v1.Ping.jsonschema.bundle.json",
