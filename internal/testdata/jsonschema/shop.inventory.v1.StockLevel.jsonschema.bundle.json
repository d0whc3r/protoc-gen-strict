{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "shop.inventory.v1.StockLevel.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "StockLevel is the current quantity of a product in a warehouse.",
      "patternProperties": {
        "^(counted_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "When the level was last recounted, at most 90 days ago."
        },
        "^(on_hand)$": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Units physically present."
        },
        "^(product_id)$": {
          "default": "",
          "description": "The product being counted.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "^(reorder_threshold)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Shorthand CEL form: expression only, no id or message."
        }
      },
      "properties": {
        "countedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "When the level was last recounted, at most 90 days ago."
        },
        "onHand": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Units physically present."
        },
        "productId": {
          "default": "",
          "description": "The product being counted.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "reorderThreshold": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Shorthand CEL form: expression only, no id or message."
        },
        "reserved": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Units promised to orders but not yet shipped."
        }
      },
      "title": "Stock Level",
      "type": "object"
    }
  },
  "$id": "shop.inventory.v1.StockLevel.jsonschema.bundle.json",
  "$ref": "#/$defs/shop.inventory.v1.StockLevel.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
