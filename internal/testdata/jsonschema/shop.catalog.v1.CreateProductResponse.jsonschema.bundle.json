{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "shop.catalog.v1.CreateProductResponse.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "CreateProductResponse returns the stored product.",
      "properties": {
        "product": {
          "$ref": "#/$defs/shop.catalog.v1.Product.jsonschema.json",
          "description": "The created product, with server-assigned fields filled in."
        }
      },
      "title": "Create Product Response",
      "type": "object"
    },
    "shop.catalog.v1.Product.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Product is the catalog resource.",
      "patternProperties": {
        "^(created_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Creation time."
        },
        "^(created_by_email)$": {
          "default": "",
          "description": "Email of the creator. Empty when the product was created by an automation.",
          "type": "string"
        },
        "^(discount_price)$": {
          "$ref": "#/$defs/shop.common.v1.Money.jsonschema.json",
          "description": "Optional promotional price."
        },
        "^(published_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Publication time, absent while the product is a draft."
        },
        "^(updated_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Last modification time."
        }
      },
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Creation time."
        },
        "createdByEmail": {
          "default": "",
          "description": "Email of the creator. Empty when the product was created by an automation.",
          "type": "string"
        },
        "description": {
          "description": "Long form description.",
          "maxLength": 4096,
          "type": "string"
        },
        "discountPrice": {
          "$ref": "#/$defs/shop.common.v1.Money.jsonschema.json",
          "description": "Optional promotional price."
        },
        "id": {
          "default": "",
          "description": "Server-assigned identifier.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Arbitrary labels attached to the product.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "default": "",
          "description": "Display name.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/shop.common.v1.Money.jsonschema.json",
          "description": "List price."
        },
        "publishedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Publication time, absent while the product is a draft."
        },
        "sku": {
          "default": "",
          "description": "Stock keeping unit, uppercase alphanumeric with dashes.",
          "maxLength": 32,
          "minLength": 3,
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "pattern": "^PRODUCT_STATUS_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "PRODUCT_STATUS_ACTIVE",
                "PRODUCT_STATUS_ARCHIVED",
                "PRODUCT_STATUS_DRAFT"
              ],
              "type": "string"
            },
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Lifecycle state.",
          "title": "Product Status"
        },
        "tags": {
          "description": "Free-form tags, deduplicated by the server.",
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "updatedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json",
          "description": "Last modification time."
        },
        "version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Optimistic concurrency token, incremented on every write."
        }
      },
      "required": [
        "price"
      ],
      "title": "Product",
      "type": "object"
    },
    "shop.common.v1.Money.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Money is a fixed-point amount, split into whole units and nanos the way\n google.type.Money does.",
      "properties": {
        "currency": {
          "anyOf": [
            {
              "enum": [
                "CURRENCY_EUR",
                "CURRENCY_USD",
                "CURRENCY_GBP"
              ],
              "type": "string"
            },
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "description": "The currency of the amount.",
          "title": "Currency"
        },
        "nanos": {
          "anyOf": [
            {
              "maximum": 999999999,
              "minimum": -999999999,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Fractional part in nanos, e.g. 500000000 for 12.50 EUR."
        },
        "units": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": -1000000000,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Whole currency units, e.g. 12 for 12.50 EUR."
        }
      },
      "required": [
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "$id": "shop.catalog.v1.CreateProductResponse.jsonschema.bundle.json",
  "$ref": "#/$defs/shop.catalog.v1.CreateProductResponse.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
