    },
    "google.protobuf.FloatValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "maximum": 3.4028234663852886e+38,
          "minimum": -3.4028234663852886e+38,
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "The float value.",
      "title": "Float Value"
    },
    "google.protobuf.Int32Value.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "description": "The int32 value.",
      "title": "Int32 Value"
    },
    "google.protobuf.Int64Value.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "description": "The int64 value.",
      "title": "Int64 Value"
    },
    "google.protobuf.ListValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "List Value",
      "type": "array"
    },
    "google.protobuf.StringValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
